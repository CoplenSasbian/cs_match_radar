<?xml version="1.0" encoding="utf-8"?>
<!--
    对局窗口：展示某个玩家的最近对局。
    布局与主窗口的 5E 页一致 —— 左侧对局列表，右侧队伍 A / B 详情。
-->
<Window
    x:Class="App1.MatchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="对局">

    <Grid>
        <Grid.Resources>
            <!-- 5E 对局详情中的一名玩家 -->
            <DataTemplate x:Key="PlayerRowTemplate" x:DataType="local:PlayerRow">
                <Grid Padding="6,5" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind MvpText}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Visibility="{x:Bind MvpVisibility}"/>
                            <TextBlock Text="{x:Bind GroupText}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind KdaText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind RatingText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind AdrText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind RwsText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind KastText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind HeadshotText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind KdText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- 完美对局详情中的一名玩家 -->
            <DataTemplate x:Key="PerfectPlayerRowTemplate" x:DataType="local:PerfectMatchPlayerRow">
                <Grid Padding="6,5" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind MvpText}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Visibility="{x:Bind MvpVisibility}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind KdaText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind RatingText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind AdrText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind RwsText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind WeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind HeadshotText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind KdText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：显示是谁的对局。
             右侧固定 138px 留给系统的最小/最大化/关闭按钮，
             自定义控件放在它左边并右对齐，避免被系统按钮压住点不到。 -->
        <Grid x:Name="MatchTitleBar" Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              ColumnSpacing="10" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="138"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="12,0,0,0">
                <TextBlock x:Name="PlayerTitle" Text="对局"
                           FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PlayerSubtitle" Text=""
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <!-- 平台与数据来源切换（仅完美平台有 dataSource）。
                 右对齐到系统按钮左侧，躲避系统按钮。 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="SourceBox" Width="132" SelectedIndex="0"
                          SelectionChanged="OnSourceChanged"
                          ToolTipService.ToolTip="对局数据来源"
                          Visibility="Collapsed">
                    <ComboBoxItem Content="完美天梯"/>
                    <ComboBoxItem Content="国服竞技"/>
                    <ComboBoxItem Content="国际服竞技"/>
                </ComboBox>
                <ComboBox x:Name="CountBox" Width="104" SelectedIndex="1"
                          ToolTipService.ToolTip="拉取场次上限">
                    <ComboBoxItem Content="10 场"/>
                    <ComboBoxItem Content="20 场"/>
                    <ComboBoxItem Content="50 场"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Content="刷新" Click="OnRefreshClick"/>
            </StackPanel>
            <!-- Grid.Column=2 留空，交给系统绘制最小/最大化/关闭按钮。 -->
        </Grid>

        <!-- 主体：左列表 + 右详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左：对局列表（5E / 完美各一套模板） -->
            <Grid Grid.Column="0">
                <ListView x:Name="MatchList"
                          SelectionMode="Single"
                          SelectionChanged="OnMatchSelectionChanged"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MatchRow">
                            <Grid Padding="4,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                           Fill="{x:Bind ResultBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{x:Bind MapLabel}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind KdaText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind RatingText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind AdrText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind TimeText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ScoreText}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{x:Bind EloText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 完美平台用另一套行视图（字段名不同） -->
                <ListView x:Name="PerfectMatchList"
                          SelectionMode="Single"
                          SelectionChanged="OnPerfectMatchSelectionChanged"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PerfectMatchRow">
                            <Grid Padding="4,6" ColumnSpacing="10" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                                   Fill="{x:Bind ResultBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind MapLabel}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind MvpText}" FontSize="11"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                <TextBlock Text="{x:Bind MultiKillText}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                <TextBlock Text="{x:Bind DurationText}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind KdaText}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind RatingText}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind WeText}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind TimeText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind ScoreText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{x:Bind EloText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Rectangle Grid.Column="1" Width="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 右：详情 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 对局概要 -->
                <StackPanel Grid.Row="0" Padding="16,12" Spacing="6">
                    <TextBlock x:Name="MatchTitle" Text="对局详情"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MatchSubtitle" Text="从左侧选择一场对局"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="MatchStats" Orientation="Horizontal"
                                Spacing="20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="比分" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="StatScore" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="总回合" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="StatRounds" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="时长" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="StatDuration" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button x:Name="DemoButton" Content="复制 Demo 链接"
                                Click="OnCopyDemoClick" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,0,16,16" Spacing="8">
                        <!-- 队伍 A -->
                        <TextBlock x:Name="TeamAHeader" FontSize="12" FontWeight="SemiBold"
                                   Text="队伍 A"/>
                        <ItemsControl x:Name="TeamAList"/>
                        <!-- 队伍 B -->
                        <TextBlock x:Name="TeamBHeader" FontSize="12" FontWeight="SemiBold"
                                   Text="队伍 B" Margin="0,12,0,0"/>
                        <ItemsControl x:Name="TeamBList"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Padding="12,6"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Text="就绪"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ProgressRing Grid.Column="1" x:Name="BusyRing" Width="16" Height="16"
                          IsActive="False" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
