  <!--
    项目引用会构建 5eApi / PerfectWorldApi，但不会把产出的 DLL 复制到本应用的
    输出目录，也不会登记为打包输入。MSIX 打包并不扫描输出目录，只收集显式的
    PackagingOutputs 项，因此仅把 DLL 拷进 $(OutDir) 是不够的 —— 包内仍只有
    App1.exe，运行时便会报找不到 DLL。

    这里分两步：
      1) 把 DLL 复制到 $(OutDir)；
      2) 在 _ComputeAppxPackagePayload 之前把 DLL 追加到 PackagingOutputs。
    该目标挂在 Build 之后，保证 DLL 此时已生成。
  -->
  <Target Name="CopyPlatformDlls"
          AfterTargets="Build"
          BeforeTargets="_ComputeAppxPackagePayload">
    <ItemGroup>
      <PlatformDll Include="$(ProjectDir)..\5eApi\$(Platform)\$(Configuration)\5eApi.dll" />
      <PlatformDll Include="$(ProjectDir)..\PerfectWorldApi\$(Platform)\$(Configuration)\PerfectWorldApi.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PlatformDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(PlatformDll.FullPath)')" />
    <Warning Text="未找到平台 DLL：%(PlatformDll.FullPath)"
             Condition="!Exists('%(PlatformDll.FullPath)')" />

    <!-- 登记进打包负载：TargetPath 决定包内相对路径（此处为根目录）。 -->
    <ItemGroup>
      <PackagingOutputs Include="$(OutDir)5eApi.dll" Condition="Exists('$(OutDir)5eApi.dll')">
        <ProjectName>$(ProjectName)</ProjectName>
        <TargetPath>5eApi.dll</TargetPath>
        <OutputGroup>BuiltProjectOutputGroup</OutputGroup>
      </PackagingOutputs>
      <PackagingOutputs Include="$(OutDir)PerfectWorldApi.dll" Condition="Exists('$(OutDir)PerfectWorldApi.dll')">
        <ProjectName>$(ProjectName)</ProjectName>
        <TargetPath>PerfectWorldApi.dll</TargetPath>
        <OutputGroup>BuiltProjectOutputGroup</OutputGroup>
      </PackagingOutputs>

      <!--
        扫码登录页面与脚本：WebView2 运行时按安装目录加载
        Assets\qr_page.html，因此必须与本 exe 一起落盘并进包。
        下面的 Copy 把文件放到 $(OutDir)Assets\，TargetPath 即包内路径。
      -->
      <QrAsset Include="$(ProjectDir)Assets\qr_page.html">
        <TargetPath>Assets\qr_page.html</TargetPath>
      </QrAsset>
      <QrAsset Include="$(ProjectDir)Assets\qr.js">
        <TargetPath>Assets\qr.js</TargetPath>
      </QrAsset>
      <QrAsset Include="$(ProjectDir)Assets\qrcode.min.js">
        <TargetPath>Assets\qrcode.min.js</TargetPath>
      </QrAsset>
    </ItemGroup>

    <Copy SourceFiles="@(QrAsset)"
          DestinationFiles="@(QrAsset->'$(OutDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <PackagingOutputs Include="@(QrAsset->'$(OutDir)%(TargetPath)')">
        <ProjectName>$(ProjectName)</ProjectName>
        <TargetPath>%(QrAsset.TargetPath)</TargetPath>
        <OutputGroup>BuiltProjectOutputGroup</OutputGroup>
      </PackagingOutputs>
    </ItemGroup>
  </Target>
