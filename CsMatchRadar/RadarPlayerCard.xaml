<UserControl
    x:Class="App1.RadarPlayerCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="CardBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10,12,10"
            Margin="0,0,0,10"
            PointerEntered="CardPointerEntered"
            PointerExited="CardPointerExited"
            PointerPressed="CardPointerPressed">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧风险色条 -->
            <Border Grid.Column="0" CornerRadius="2"
                    Background="{x:Bind Player.RiskBrush, Mode=OneWay}"
                    VerticalAlignment="Stretch"/>

            <!-- 主体内容 -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 名字 + 风险徽章 + 我 -->
                <Grid Grid.Row="0" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind Player.Name, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Visibility="{x:Bind Player.IsMe, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="我" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{x:Bind Player.RiskBrush, Mode=OneWay}"
                            CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Player.RiskBadge, Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </Grid>

                <!-- 两平台数据 -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 5E -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="5E" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Player.FiveERank, Mode=OneWay}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Player.FiveEPlaytime, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Player.FiveEStatus, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind Player.FiveEStatusBrush, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 完美 -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="完美世界" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Player.PerfectRank, Mode=OneWay}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Player.PerfectPlaytime, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Player.PerfectStatus, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind Player.PerfectStatusBrush, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 打开页面按钮 -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="5E 资料页"
                            IsEnabled="{x:Bind Player.HasFiveE, Mode=OneWay}"
                            Click="OnOpenFiveE"
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    <Button Grid.Column="1"
                            Content="完美资料页"
                            IsEnabled="{x:Bind Player.HasPerfect, Mode=OneWay}"
                            Click="OnOpenPerfect"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
